{
  "version": 1,
  "comment": "md formatting commands, 1.6. Offsets are UTF-16 code units; a line break is U+000A only. expected is the edit to the ORIGINAL text (replace [start, end) with text) and the selection in the RESULTING text, or null for no edit. Every unit outside U+0020-U+007E is a \\uXXXX escape. Generated by the TypeScript reference docs/formatting.md was written against; a disputed vector is changed here first, in one commit across md, md.macOS, md.Android and md.win.",
  "format": [
    {"id": "bold-caret-empty-doc", "op": "bold", "text": "", "selectionStart": 0, "selectionEnd": 0, "expected": {"start": 0, "end": 0, "text": "****", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "bold-caret-mid-word", "op": "bold", "text": "abcd", "selectionStart": 2, "selectionEnd": 2, "expected": {"start": 2, "end": 2, "text": "****", "selectionStart": 4, "selectionEnd": 4}},
    {"id": "bold-caret-in-empty-pair-removes", "op": "bold", "text": "x **** y", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 2, "end": 6, "text": "", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "bold-caret-in-italic-pair-inserts", "op": "bold", "text": "x ** y", "selectionStart": 3, "selectionEnd": 3, "expected": {"start": 3, "end": 3, "text": "****", "selectionStart": 5, "selectionEnd": 5}},
    {"id": "bold-wrap-word", "op": "bold", "text": "say hello now", "selectionStart": 4, "selectionEnd": 9, "expected": {"start": 4, "end": 9, "text": "**hello**", "selectionStart": 6, "selectionEnd": 11}},
    {"id": "bold-wrap-trims-blanks", "op": "bold", "text": "say hello now", "selectionStart": 3, "selectionEnd": 10, "expected": {"start": 4, "end": 9, "text": "**hello**", "selectionStart": 6, "selectionEnd": 11}},
    {"id": "bold-wrap-trims-newline", "op": "bold", "text": "aword\u000Ab", "selectionStart": 1, "selectionEnd": 6, "expected": {"start": 1, "end": 5, "text": "**word**", "selectionStart": 3, "selectionEnd": 7}},
    {"id": "bold-all-blank-selection-inserts-pair", "op": "bold", "text": "a   b", "selectionStart": 1, "selectionEnd": 4, "expected": {"start": 1, "end": 1, "text": "****", "selectionStart": 3, "selectionEnd": 3}},
    {"id": "bold-unwrap-outside", "op": "bold", "text": "say **hello** now", "selectionStart": 6, "selectionEnd": 11, "expected": {"start": 4, "end": 13, "text": "hello", "selectionStart": 4, "selectionEnd": 9}},
    {"id": "bold-unwrap-inside", "op": "bold", "text": "say **hello** now", "selectionStart": 4, "selectionEnd": 13, "expected": {"start": 4, "end": 13, "text": "hello", "selectionStart": 4, "selectionEnd": 9}},
    {"id": "bold-on-italic-wraps", "op": "bold", "text": "say *hello* now", "selectionStart": 5, "selectionEnd": 10, "expected": {"start": 5, "end": 10, "text": "**hello**", "selectionStart": 7, "selectionEnd": 12}},
    {"id": "bold-on-bold-italic-outside", "op": "bold", "text": "say ***hello*** now", "selectionStart": 7, "selectionEnd": 12, "expected": {"start": 5, "end": 14, "text": "hello", "selectionStart": 5, "selectionEnd": 10}},
    {"id": "bold-on-bold-italic-inside", "op": "bold", "text": "say ***hello*** now", "selectionStart": 4, "selectionEnd": 15, "expected": {"start": 4, "end": 15, "text": "*hello*", "selectionStart": 4, "selectionEnd": 11}},
    {"id": "bold-selection-all-stars-wraps", "op": "bold", "text": "a **** b", "selectionStart": 2, "selectionEnd": 6, "expected": {"start": 2, "end": 6, "text": "********", "selectionStart": 4, "selectionEnd": 8}},
    {"id": "bold-multiline", "op": "bold", "text": "one\u000Atwo", "selectionStart": 0, "selectionEnd": 7, "expected": {"start": 0, "end": 7, "text": "**one\u000Atwo**", "selectionStart": 2, "selectionEnd": 9}},
    {"id": "bold-unicode", "op": "bold", "text": "\u00E9 \u041F\u0440\u0438\u0432\u0435\u0442 \uD83D\uDC4B ok", "selectionStart": 2, "selectionEnd": 11, "expected": {"start": 2, "end": 11, "text": "**\u041F\u0440\u0438\u0432\u0435\u0442 \uD83D\uDC4B**", "selectionStart": 4, "selectionEnd": 13}},
    {"id": "bold-reversed-not-possible-caret-end", "op": "bold", "text": "word", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 4, "end": 4, "text": "****", "selectionStart": 6, "selectionEnd": 6}},
    {"id": "italic-caret", "op": "italic", "text": "ab", "selectionStart": 1, "selectionEnd": 1, "expected": {"start": 1, "end": 1, "text": "**", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "italic-caret-in-empty-pair-removes", "op": "italic", "text": "**", "selectionStart": 1, "selectionEnd": 1, "expected": {"start": 0, "end": 2, "text": "", "selectionStart": 0, "selectionEnd": 0}},
    {"id": "italic-caret-in-bold-pair-inserts", "op": "italic", "text": "****", "selectionStart": 2, "selectionEnd": 2, "expected": {"start": 2, "end": 2, "text": "**", "selectionStart": 3, "selectionEnd": 3}},
    {"id": "italic-wrap", "op": "italic", "text": "word", "selectionStart": 0, "selectionEnd": 4, "expected": {"start": 0, "end": 4, "text": "*word*", "selectionStart": 1, "selectionEnd": 5}},
    {"id": "italic-unwrap-outside", "op": "italic", "text": "*word*", "selectionStart": 1, "selectionEnd": 5, "expected": {"start": 0, "end": 6, "text": "word", "selectionStart": 0, "selectionEnd": 4}},
    {"id": "italic-unwrap-inside", "op": "italic", "text": "*word*", "selectionStart": 0, "selectionEnd": 6, "expected": {"start": 0, "end": 6, "text": "word", "selectionStart": 0, "selectionEnd": 4}},
    {"id": "italic-on-bold-wraps-outside", "op": "italic", "text": "**word**", "selectionStart": 2, "selectionEnd": 6, "expected": {"start": 2, "end": 6, "text": "*word*", "selectionStart": 3, "selectionEnd": 7}},
    {"id": "italic-on-bold-inside-wraps", "op": "italic", "text": "**word**", "selectionStart": 0, "selectionEnd": 8, "expected": {"start": 0, "end": 8, "text": "***word***", "selectionStart": 1, "selectionEnd": 9}},
    {"id": "italic-on-bold-italic-outside", "op": "italic", "text": "***word***", "selectionStart": 3, "selectionEnd": 7, "expected": {"start": 2, "end": 8, "text": "word", "selectionStart": 2, "selectionEnd": 6}},
    {"id": "italic-on-bold-italic-inside", "op": "italic", "text": "***word***", "selectionStart": 0, "selectionEnd": 10, "expected": {"start": 0, "end": 10, "text": "**word**", "selectionStart": 0, "selectionEnd": 8}},
    {"id": "italic-underscore-outside", "op": "italic", "text": "_word_", "selectionStart": 1, "selectionEnd": 5, "expected": {"start": 0, "end": 6, "text": "word", "selectionStart": 0, "selectionEnd": 4}},
    {"id": "italic-underscore-inside", "op": "italic", "text": "_word_", "selectionStart": 0, "selectionEnd": 6, "expected": {"start": 0, "end": 6, "text": "word", "selectionStart": 0, "selectionEnd": 4}},
    {"id": "italic-double-underscore-wraps", "op": "italic", "text": "__word__", "selectionStart": 2, "selectionEnd": 6, "expected": {"start": 2, "end": 6, "text": "*word*", "selectionStart": 3, "selectionEnd": 7}},
    {"id": "italic-lopsided-wraps", "op": "italic", "text": "*word**", "selectionStart": 1, "selectionEnd": 5, "expected": {"start": 1, "end": 5, "text": "*word*", "selectionStart": 2, "selectionEnd": 6}},
    {"id": "code-caret", "op": "code", "text": "x", "selectionStart": 1, "selectionEnd": 1, "expected": {"start": 1, "end": 1, "text": "``", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "code-caret-in-empty-pair-removes", "op": "code", "text": "a `` b", "selectionStart": 3, "selectionEnd": 3, "expected": {"start": 2, "end": 4, "text": "", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "code-wrap", "op": "code", "text": "run npm test now", "selectionStart": 4, "selectionEnd": 12, "expected": {"start": 4, "end": 12, "text": "`npm test`", "selectionStart": 5, "selectionEnd": 13}},
    {"id": "code-unwrap-outside", "op": "code", "text": "run `npm test` now", "selectionStart": 5, "selectionEnd": 13, "expected": {"start": 4, "end": 14, "text": "npm test", "selectionStart": 4, "selectionEnd": 12}},
    {"id": "code-unwrap-inside", "op": "code", "text": "run `npm test` now", "selectionStart": 4, "selectionEnd": 14, "expected": {"start": 4, "end": 14, "text": "npm test", "selectionStart": 4, "selectionEnd": 12}},
    {"id": "code-double-backticks-wraps", "op": "code", "text": "``a``", "selectionStart": 2, "selectionEnd": 3, "expected": {"start": 2, "end": 3, "text": "`a`", "selectionStart": 3, "selectionEnd": 4}},
    {"id": "code-selection-one-backtick", "op": "code", "text": "`", "selectionStart": 0, "selectionEnd": 1, "expected": {"start": 0, "end": 1, "text": "```", "selectionStart": 1, "selectionEnd": 2}},
    {"id": "strike-caret", "op": "strikethrough", "text": "", "selectionStart": 0, "selectionEnd": 0, "expected": {"start": 0, "end": 0, "text": "~~~~", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "strike-caret-in-pair-removes", "op": "strikethrough", "text": "~~~~", "selectionStart": 2, "selectionEnd": 2, "expected": {"start": 0, "end": 4, "text": "", "selectionStart": 0, "selectionEnd": 0}},
    {"id": "strike-wrap", "op": "strikethrough", "text": "it was wrong", "selectionStart": 7, "selectionEnd": 12, "expected": {"start": 7, "end": 12, "text": "~~wrong~~", "selectionStart": 9, "selectionEnd": 14}},
    {"id": "strike-unwrap-outside", "op": "strikethrough", "text": "it was ~~wrong~~", "selectionStart": 9, "selectionEnd": 14, "expected": {"start": 7, "end": 16, "text": "wrong", "selectionStart": 7, "selectionEnd": 12}},
    {"id": "strike-unwrap-inside", "op": "strikethrough", "text": "it was ~~wrong~~", "selectionStart": 7, "selectionEnd": 16, "expected": {"start": 7, "end": 16, "text": "wrong", "selectionStart": 7, "selectionEnd": 12}},
    {"id": "strike-single-tilde-wraps", "op": "strikethrough", "text": "~a~", "selectionStart": 1, "selectionEnd": 2, "expected": {"start": 1, "end": 2, "text": "~~a~~", "selectionStart": 3, "selectionEnd": 4}},
    {"id": "link-caret", "op": "link", "text": "see  here", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 4, "end": 4, "text": "[]()", "selectionStart": 5, "selectionEnd": 5}},
    {"id": "link-wrap-text", "op": "link", "text": "see the docs here", "selectionStart": 4, "selectionEnd": 12, "expected": {"start": 4, "end": 12, "text": "[the docs](url)", "selectionStart": 15, "selectionEnd": 18}},
    {"id": "link-wrap-trims", "op": "link", "text": "see the docs here", "selectionStart": 3, "selectionEnd": 13, "expected": {"start": 4, "end": 12, "text": "[the docs](url)", "selectionStart": 15, "selectionEnd": 18}},
    {"id": "link-url", "op": "link", "text": "see https://example.com/a?b=c", "selectionStart": 4, "selectionEnd": 29, "expected": {"start": 4, "end": 29, "text": "[](https://example.com/a?b=c)", "selectionStart": 5, "selectionEnd": 5}},
    {"id": "link-url-case", "op": "link", "text": "HTTP://EXAMPLE.COM", "selectionStart": 0, "selectionEnd": 18, "expected": {"start": 0, "end": 18, "text": "[](HTTP://EXAMPLE.COM)", "selectionStart": 1, "selectionEnd": 1}},
    {"id": "link-url-with-space-is-text", "op": "link", "text": "https://a b", "selectionStart": 0, "selectionEnd": 11, "expected": {"start": 0, "end": 11, "text": "[https://a b](url)", "selectionStart": 14, "selectionEnd": 17}},
    {"id": "link-ftp-is-text", "op": "link", "text": "ftp://x", "selectionStart": 0, "selectionEnd": 7, "expected": {"start": 0, "end": 7, "text": "[ftp://x](url)", "selectionStart": 10, "selectionEnd": 13}},
    {"id": "link-all-blank", "op": "link", "text": "a  b", "selectionStart": 1, "selectionEnd": 3, "expected": {"start": 1, "end": 1, "text": "[]()", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "h1-plain-caret", "op": "heading1", "text": "Title", "selectionStart": 2, "selectionEnd": 2, "expected": {"start": 0, "end": 5, "text": "# Title", "selectionStart": 4, "selectionEnd": 4}},
    {"id": "h1-caret-empty-line", "op": "heading1", "text": "", "selectionStart": 0, "selectionEnd": 0, "expected": {"start": 0, "end": 0, "text": "# ", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "h1-caret-at-col0", "op": "heading1", "text": "Title", "selectionStart": 0, "selectionEnd": 0, "expected": {"start": 0, "end": 5, "text": "# Title", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "h1-toggle-off", "op": "heading1", "text": "# Title", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 7, "text": "Title", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "h2-replaces-h1", "op": "heading2", "text": "# Title", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 7, "text": "## Title", "selectionStart": 5, "selectionEnd": 5}},
    {"id": "h3-replaces-h6", "op": "heading3", "text": "###### Title", "selectionStart": 9, "selectionEnd": 9, "expected": {"start": 0, "end": 12, "text": "### Title", "selectionStart": 6, "selectionEnd": 6}},
    {"id": "h1-caret-inside-marker", "op": "heading1", "text": "### Title", "selectionStart": 1, "selectionEnd": 1, "expected": {"start": 0, "end": 9, "text": "# Title", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "h2-bare-hashes", "op": "heading2", "text": "##", "selectionStart": 2, "selectionEnd": 2, "expected": {"start": 0, "end": 2, "text": "", "selectionStart": 0, "selectionEnd": 0}},
    {"id": "h1-seven-hashes-is-text", "op": "heading1", "text": "####### x", "selectionStart": 9, "selectionEnd": 9, "expected": {"start": 0, "end": 9, "text": "# ####### x", "selectionStart": 11, "selectionEnd": 11}},
    {"id": "h1-hash-no-space-is-text", "op": "heading1", "text": "#tag", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 4, "text": "# #tag", "selectionStart": 6, "selectionEnd": 6}},
    {"id": "h2-indented-3", "op": "heading2", "text": "   text", "selectionStart": 5, "selectionEnd": 5, "expected": {"start": 0, "end": 7, "text": "   ## text", "selectionStart": 8, "selectionEnd": 8}},
    {"id": "h2-indented-4-goes-col0", "op": "heading2", "text": "    text", "selectionStart": 6, "selectionEnd": 6, "expected": {"start": 0, "end": 8, "text": "##     text", "selectionStart": 9, "selectionEnd": 9}},
    {"id": "h2-indented-tab-goes-col0", "op": "heading2", "text": "\u0009text", "selectionStart": 3, "selectionEnd": 3, "expected": {"start": 0, "end": 5, "text": "## \u0009text", "selectionStart": 6, "selectionEnd": 6}},
    {"id": "h1-multiline-mixed", "op": "heading1", "text": "one\u000A# two\u000Athree", "selectionStart": 0, "selectionEnd": 15, "expected": {"start": 0, "end": 15, "text": "# one\u000A# two\u000A# three", "selectionStart": 2, "selectionEnd": 19}},
    {"id": "h1-multiline-all-off", "op": "heading1", "text": "# one\u000A\u000A# two", "selectionStart": 0, "selectionEnd": 12, "expected": {"start": 0, "end": 12, "text": "one\u000A\u000Atwo", "selectionStart": 0, "selectionEnd": 8}},
    {"id": "h1-multiline-skips-blank", "op": "heading1", "text": "one\u000A\u000Atwo", "selectionStart": 0, "selectionEnd": 8, "expected": {"start": 0, "end": 8, "text": "# one\u000A\u000A# two", "selectionStart": 2, "selectionEnd": 12}},
    {"id": "h1-selection-ends-col0-next", "op": "heading1", "text": "one\u000Atwo", "selectionStart": 0, "selectionEnd": 4, "expected": {"start": 0, "end": 3, "text": "# one", "selectionStart": 2, "selectionEnd": 6}},
    {"id": "h6", "op": "heading6", "text": "x", "selectionStart": 1, "selectionEnd": 1, "expected": {"start": 0, "end": 1, "text": "###### x", "selectionStart": 8, "selectionEnd": 8}},
    {"id": "h4-in-second-line", "op": "heading4", "text": "a\u000Ab\u000Ac", "selectionStart": 3, "selectionEnd": 3, "expected": {"start": 2, "end": 3, "text": "#### b", "selectionStart": 8, "selectionEnd": 8}},
    {"id": "cycle-none-to-1", "op": "headingCycle", "text": "x", "selectionStart": 1, "selectionEnd": 1, "expected": {"start": 0, "end": 1, "text": "# x", "selectionStart": 3, "selectionEnd": 3}},
    {"id": "cycle-1-to-2", "op": "headingCycle", "text": "# x", "selectionStart": 3, "selectionEnd": 3, "expected": {"start": 0, "end": 3, "text": "## x", "selectionStart": 4, "selectionEnd": 4}},
    {"id": "cycle-2-to-3", "op": "headingCycle", "text": "## x", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 4, "text": "### x", "selectionStart": 5, "selectionEnd": 5}},
    {"id": "cycle-3-to-none", "op": "headingCycle", "text": "### x", "selectionStart": 5, "selectionEnd": 5, "expected": {"start": 0, "end": 5, "text": "x", "selectionStart": 1, "selectionEnd": 1}},
    {"id": "cycle-5-to-none", "op": "headingCycle", "text": "##### x", "selectionStart": 7, "selectionEnd": 7, "expected": {"start": 0, "end": 7, "text": "x", "selectionStart": 1, "selectionEnd": 1}},
    {"id": "cycle-multiline-follows-first", "op": "headingCycle", "text": "# a\u000Ab\u000A### c", "selectionStart": 0, "selectionEnd": 11, "expected": {"start": 0, "end": 11, "text": "## a\u000A## b\u000A## c", "selectionStart": 0, "selectionEnd": 14}},
    {"id": "bullet-caret", "op": "bulletList", "text": "item", "selectionStart": 2, "selectionEnd": 2, "expected": {"start": 0, "end": 4, "text": "- item", "selectionStart": 4, "selectionEnd": 4}},
    {"id": "bullet-caret-empty-line", "op": "bulletList", "text": "", "selectionStart": 0, "selectionEnd": 0, "expected": {"start": 0, "end": 0, "text": "- ", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "bullet-toggle-off", "op": "bulletList", "text": "- item", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 6, "text": "item", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "bullet-star-off", "op": "bulletList", "text": "* item", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 6, "text": "item", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "bullet-indented-keeps-indent", "op": "bulletList", "text": "  item", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 6, "text": "  - item", "selectionStart": 6, "selectionEnd": 6}},
    {"id": "bullet-from-ordered", "op": "bulletList", "text": "12. item", "selectionStart": 6, "selectionEnd": 6, "expected": {"start": 0, "end": 8, "text": "- item", "selectionStart": 4, "selectionEnd": 4}},
    {"id": "bullet-from-ordered-paren", "op": "bulletList", "text": "3) item", "selectionStart": 5, "selectionEnd": 5, "expected": {"start": 0, "end": 7, "text": "- item", "selectionStart": 4, "selectionEnd": 4}},
    {"id": "bullet-from-task", "op": "bulletList", "text": "- [x] item", "selectionStart": 8, "selectionEnd": 8, "expected": {"start": 0, "end": 10, "text": "- item", "selectionStart": 4, "selectionEnd": 4}},
    {"id": "bullet-multiline-mixed", "op": "bulletList", "text": "a\u000A- b\u000Ac", "selectionStart": 0, "selectionEnd": 7, "expected": {"start": 0, "end": 7, "text": "- a\u000A- b\u000A- c", "selectionStart": 2, "selectionEnd": 11}},
    {"id": "bullet-multiline-all-off", "op": "bulletList", "text": "- a\u000A\u000A+ b", "selectionStart": 0, "selectionEnd": 8, "expected": {"start": 0, "end": 8, "text": "a\u000A\u000Ab", "selectionStart": 0, "selectionEnd": 4}},
    {"id": "bullet-multiline-with-task-adds", "op": "bulletList", "text": "- a\u000A- [ ] b", "selectionStart": 0, "selectionEnd": 11, "expected": {"start": 0, "end": 11, "text": "- a\u000A- b", "selectionStart": 0, "selectionEnd": 7}},
    {"id": "bullet-dash-no-space-is-text", "op": "bulletList", "text": "-x", "selectionStart": 2, "selectionEnd": 2, "expected": {"start": 0, "end": 2, "text": "- -x", "selectionStart": 4, "selectionEnd": 4}},
    {"id": "bullet-bare-dash-off", "op": "bulletList", "text": "-", "selectionStart": 1, "selectionEnd": 1, "expected": {"start": 0, "end": 1, "text": "", "selectionStart": 0, "selectionEnd": 0}},
    {"id": "bullet-ten-digits-is-text", "op": "bulletList", "text": "1234567890. x", "selectionStart": 13, "selectionEnd": 13, "expected": {"start": 0, "end": 13, "text": "- 1234567890. x", "selectionStart": 15, "selectionEnd": 15}},
    {"id": "bullet-caret-before-marker", "op": "bulletList", "text": "- item", "selectionStart": 0, "selectionEnd": 0, "expected": {"start": 0, "end": 6, "text": "item", "selectionStart": 0, "selectionEnd": 0}},
    {"id": "task-caret", "op": "taskList", "text": "item", "selectionStart": 2, "selectionEnd": 2, "expected": {"start": 0, "end": 4, "text": "- [ ] item", "selectionStart": 8, "selectionEnd": 8}},
    {"id": "task-from-bullet", "op": "taskList", "text": "- item", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 6, "text": "- [ ] item", "selectionStart": 8, "selectionEnd": 8}},
    {"id": "task-from-star-bullet", "op": "taskList", "text": "* item", "selectionStart": 4, "selectionEnd": 4, "expected": {"start": 0, "end": 6, "text": "* [ ] item", "selectionStart": 8, "selectionEnd": 8}},
