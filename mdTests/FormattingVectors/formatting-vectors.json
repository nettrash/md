    {"id": "task-from-ordered", "op": "taskList", "text": "1. item", "selectionStart": 5, "selectionEnd": 5, "expected": {"start": 0, "end": 7, "text": "- [ ] item", "selectionStart": 8, "selectionEnd": 8}},
    {"id": "task-toggle-off", "op": "taskList", "text": "- [ ] item", "selectionStart": 8, "selectionEnd": 8, "expected": {"start": 0, "end": 10, "text": "item", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "task-checked-off", "op": "taskList", "text": "- [X] item", "selectionStart": 8, "selectionEnd": 8, "expected": {"start": 0, "end": 10, "text": "item", "selectionStart": 2, "selectionEnd": 2}},
    {"id": "task-box-at-end", "op": "taskList", "text": "- [ ]", "selectionStart": 5, "selectionEnd": 5, "expected": {"start": 0, "end": 5, "text": "", "selectionStart": 0, "selectionEnd": 0}},
    {"id": "task-box-no-space-is-bullet", "op": "taskList", "text": "- [ ]x", "selectionStart": 6, "selectionEnd": 6, "expected": {"start": 0, "end": 6, "text": "- [ ] [ ]x", "selectionStart": 10, "selectionEnd": 10}},
    {"id": "task-indented", "op": "taskList", "text": "    - item", "selectionStart": 8, "selectionEnd": 8, "expected": {"start": 0, "end": 10, "text": "    - [ ] item", "selectionStart": 12, "selectionEnd": 12}},
    {"id": "task-multiline-mixed", "op": "taskList", "text": "- [ ] a\u000Ab", "selectionStart": 0, "selectionEnd": 9, "expected": {"start": 0, "end": 9, "text": "- [ ] a\u000A- [ ] b", "selectionStart": 0, "selectionEnd": 15}},
