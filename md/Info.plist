<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle metadata. Version / build come from MARKETING_VERSION and
         the agvtool-managed CURRENT_PROJECT_VERSION; everything else is
         hard-coded here (GENERATE_INFOPLIST_FILE is off). -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>md</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- The app makes no network connections and uses no encryption, so it
         is exempt from U.S. export compliance. Declaring this here means
         App Store Connect won't ask the export-compliance question on every
         upload. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!--
        Document handling. The app owns Markdown and opens plain text as
        an alternate. `LSSupportsOpeningDocumentsInPlace` lets the editor
        modify the original file (in Files / Finder / iCloud Drive) rather
        than an imported copy — the right behaviour for an editor.

        Markdown is claimed twice on purpose: once under the system's own
        identifier (.md) and once under our alias identifier, which carries
        every other Markdown extension, .markdown included — see the type
        declarations below for why the two cannot be one.
    -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document (other extensions)</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>me.nettrash.md.markdown-alias</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>PlantUML Diagram</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.sourceforge.plantuml.puml</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Graphviz DOT Graph</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.graphviz.dot</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>TextBundle</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.textbundle.package</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>TextPack</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.textbundle.pack</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Plain Text</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.plain-text</string>
            </array>
        </dict>
    </array>

    <!--
        The Markdown extensions the app does not get to attach to Markdown's
        own identifier — every spelling except .md, .markdown included.

        Why a second identifier: `net.daringfireball.markdown` is declared by
        the system itself, and a declaration the system already owns beats
        any app's copy of it: Launch Services registers the app's copy as
        *inactive* (`lsregister -dump` shows `flags: inactive imported`) and
        every tag on the copy that the live declaration lacks is dropped. So
        listing `mdown`, `mkd`, … on `net.daringfireball.markdown` below did
        nothing — those files resolved to dynamic `dyn.*` types and md was
        never offered for them.

        Which tags the live declaration carries depends on the OS release,
        and that is why .markdown is here too. On macOS and on iOS 27
        CoreTypes exports the identifier with `md`, `markdown` and
        `text/markdown` (the 27 SDK surfaces it as `UTTypeMarkdown`). On
        iOS 26 — the iOS app's deployment target — CoreTypes does not
        declare it at all; the built-in Shortcuts app *imports* it with the
        single extension `md`, and a built-in app's copy is registered
        before ours and wins the same way. So on iOS 26 `.markdown`, which
        existed only on md's copy, was dropped and never associated with md
        either.

        Tags only take effect on an identifier nobody above us declares, so
        every extension but `md` lives here, on an identifier in our own
        namespace, *exported* because we own it (`UTType(exportedAs:)` in
        MarkdownDocument.swift). It conforms to `net.daringfireball.markdown`,
        so anything that asks "is this Markdown?" — including the document
        types above and readableContentTypes — still says yes, and to
        public.plain-text so the bytes are read and written as ordinary
        text. Where the system's own declaration also lists `markdown`
        (macOS, iOS 27) a .markdown file resolves to the system's type;
        where it does not (iOS 26) it resolves to this one. Both are md's,
        and both open and save in place. `markdown` is listed first so that
        it is this type's preferred extension. Do not fold these extensions
        back into the declaration below: they would be silently discarded
        again.
    -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>me.nettrash.md.markdown-alias</string>
            <key>UTTypeDescription</key>
            <string>Markdown Text</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>net.daringfireball.markdown</string>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>markdown</string>
                    <string>mdown</string>
                    <string>markdn</string>
                    <string>mdtext</string>
                    <string>mdtxt</string>
                    <string>mkd</string>
                    <string>mkdn</string>
                    <string>mdwn</string>
                    <string>mkdown</string>
                </array>
            </dict>
        </dict>
    </array>

    <!--
        Markdown is owned by Daring Fireball, so we *import* (not export)
        its identifier. It conforms to public.plain-text, so the files we
        read and write are ordinary UTF-8 text.

        Only `md` is listed: the one tag every system declaration of this
        identifier carries (macOS and iOS 27 list `md` and `markdown`, iOS 26
        only `md` — see the exported declaration above). The system owns the
        identifier wherever it declares it, so this copy is inactive there
        and only its agreement with the original matters; on a system with
        no declaration of its own this copy is live and .md resolves to it.
        Anything more here would be discarded, and listing the same
        extension in two of our declarations would leave it ambiguous; every
        other Markdown extension, .markdown included, belongs to
        me.nettrash.md.markdown-alias, where it is honoured on every release.
    -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>net.daringfireball.markdown</string>
            <key>UTTypeDescription</key>
            <string>Markdown Text</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>md</string>
                </array>
            </dict>
        </dict>
        <!--
            PlantUML source (.puml) is ordinary UTF-8 text the app opens and
            edits exactly like Markdown. The format isn't ours and the system
            declares no identifier for it, so we *import* one that conforms to
            public.plain-text (and public.source-code, itself plain text).
            Because no system declaration exists for this identifier, the
            tags here do take effect — unlike Markdown's, above — so every
            extension PlantUML files are found under is listed on it.
        -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>net.sourceforge.plantuml.puml</string>
            <key>UTTypeDescription</key>
            <string>PlantUML Diagram</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.source-code</string>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>puml</string>
                    <string>plantuml</string>
                    <string>iuml</string>
                    <string>pu</string>
                </array>
            </dict>
        </dict>
        <!--
            Graphviz DOT source (.gv) — again ordinary UTF-8 text with no
            system identifier, so we *import* one conforming to plain text.

            Only `gv` is listed. DOT's other extension, `.dot`, is already
            system-declared as `com.microsoft.word.dot` (a Word template,
            which does not conform to public.plain-text); claiming it here
            would leave the extension ambiguous and could offer md as a
            handler for genuine Word templates. Fenced ```dot blocks in a
            Markdown document are unaffected — this is only about the
            extension a bare DOT file carries.
        -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.graphviz.dot</string>
            <key>UTTypeDescription</key>
            <string>Graphviz DOT Graph</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.source-code</string>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>gv</string>
                </array>
            </dict>
        </dict>
        <!--
            TextBundle / TextPack — the Markdown-with-assets container Ulysses,
            iA Writer and Bear write. Owned by the textbundle.org spec, so we
            *import* their identifiers.

            `.textbundle` is a directory *package* (it conforms to
            com.apple.package), which is what makes the system hand the app a
            directory FileWrapper to read `text.md` out of. `.textpack` is that
            bundle zipped, so it conforms to public.zip-archive and arrives as
            ordinary file bytes the app unzips in memory. Both are read-only for
            the app (writing one back would drop its assets/) — see
            MarkdownDocument.writableContentTypes.
        -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.textbundle.package</string>
            <key>UTTypeDescription</key>
            <string>TextBundle</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.package</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>textbundle</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.textbundle.pack</string>
            <key>UTTypeDescription</key>
            <string>TextPack</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.zip-archive</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>textpack</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!--
        Expose the app's own Documents folder as a local "On My iPhone/md"
        storage location. Paired with LSSupportsOpeningDocumentsInPlace, this
        gives the document browser a guaranteed local place to create and keep
        files even when iCloud Drive isn't signed in. Without it, on a fresh
        device / simulator with no iCloud there is no valid local location, so
        the browser's "Create Document" fails with "the location could not be
        found".
    -->
    <key>UIFileSharingEnabled</key>
    <true/>

    <!-- Scene + launch scaffolding. Multiple scenes are enabled so iPad
         and Mac can open several document windows at once. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
</dict>
</plist>
