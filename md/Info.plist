<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle metadata. Version / build come from MARKETING_VERSION and
         the agvtool-managed CURRENT_PROJECT_VERSION; everything else is
         hard-coded here (GENERATE_INFOPLIST_FILE is off). -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>md</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- The app makes no network connections and uses no encryption, so it
         is exempt from U.S. export compliance. Declaring this here means
         App Store Connect won't ask the export-compliance question on every
         upload. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!--
        Document handling. The app owns Markdown and opens plain text as
        an alternate. `LSSupportsOpeningDocumentsInPlace` lets the editor
        modify the original file (in Files / Finder / iCloud Drive) rather
        than an imported copy — the right behaviour for an editor.
    -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>PlantUML Diagram</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.sourceforge.plantuml.puml</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Graphviz DOT Graph</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.graphviz.dot</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>TextBundle</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.textbundle.package</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>TextPack</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.textbundle.pack</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Plain Text</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.plain-text</string>
            </array>
        </dict>
    </array>

    <!--
        Markdown is owned by Daring Fireball, so we *import* (not export)
        its identifier and pin the common file extensions to it. It
        conforms to public.plain-text, so the files we read and write are
        ordinary UTF-8 text.
    -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>net.daringfireball.markdown</string>
            <key>UTTypeDescription</key>
            <string>Markdown Text</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>md</string>
                    <string>markdown</string>
                    <string>mdown</string>
                    <string>markdn</string>
                    <string>mdtext</string>
                </array>
            </dict>
        </dict>
        <!--
            PlantUML source (.puml) is ordinary UTF-8 text the app opens and
            edits exactly like Markdown. The format isn't ours and the system
            declares no identifier for it, so we *import* one that conforms to
            public.plain-text (and public.source-code, itself plain text).
        -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>net.sourceforge.plantuml.puml</string>
            <key>UTTypeDescription</key>
            <string>PlantUML Diagram</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.source-code</string>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>puml</string>
                    <string>plantuml</string>
                </array>
            </dict>
        </dict>
        <!--
            Graphviz DOT source (.gv) — again ordinary UTF-8 text with no
            system identifier, so we *import* one conforming to plain text.

            Only `gv` is listed. DOT's other extension, `.dot`, is already
            system-declared as `com.microsoft.word.dot` (a Word template,
            which does not conform to public.plain-text); claiming it here
            would leave the extension ambiguous and could offer md as a
            handler for genuine Word templates. Fenced ```dot blocks in a
            Markdown document are unaffected — this is only about the
            extension a bare DOT file carries.
        -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.graphviz.dot</string>
            <key>UTTypeDescription</key>
            <string>Graphviz DOT Graph</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.source-code</string>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>gv</string>
                </array>
            </dict>
        </dict>
        <!--
            TextBundle / TextPack — the Markdown-with-assets container Ulysses,
            iA Writer and Bear write. Owned by the textbundle.org spec, so we
            *import* their identifiers.

            `.textbundle` is a directory *package* (it conforms to
            com.apple.package), which is what makes the system hand the app a
            directory FileWrapper to read `text.md` out of. `.textpack` is that
            bundle zipped, so it conforms to public.zip-archive and arrives as
            ordinary file bytes the app unzips in memory. Both are read-only for
            the app (writing one back would drop its assets/) — see
            MarkdownDocument.writableContentTypes.
        -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.textbundle.package</string>
            <key>UTTypeDescription</key>
            <string>TextBundle</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.package</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>textbundle</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.textbundle.pack</string>
            <key>UTTypeDescription</key>
            <string>TextPack</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.zip-archive</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>textpack</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!--
        Expose the app's own Documents folder as a local "On My iPhone/md"
        storage location. Paired with LSSupportsOpeningDocumentsInPlace, this
        gives the document browser a guaranteed local place to create and keep
        files even when iCloud Drive isn't signed in. Without it, on a fresh
        device / simulator with no iCloud there is no valid local location, so
        the browser's "Create Document" fails with "the location could not be
        found".
    -->
    <key>UIFileSharingEnabled</key>
    <true/>

    <!-- Scene + launch scaffolding. Multiple scenes are enabled so iPad
         and Mac can open several document windows at once. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
</dict>
</plist>
