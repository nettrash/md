<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Intentionally empty. This is an iOS / iPadOS app, which is sandboxed
        implicitly and needs no `com.apple.security.*` file-access keys (those
        are macOS App Sandbox entitlements and are ignored on iOS).

        The Mac build was Mac Catalyst, but its document file management
        (enclosing-folder display, rename, New) is unfixably limited there —
        Catalyst's `DocumentGroup` is a UIKit stack bridged to AppKit, not a
        real `NSDocument` app. Catalyst is therefore disabled
        (`SUPPORTS_MACCATALYST = NO`); a proper native macOS target will be
        added later and will reintroduce the App Sandbox + user-selected /
        Downloads file-access entitlements it needs.
    -->
</dict>
</plist>
